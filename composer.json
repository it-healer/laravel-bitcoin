{
    "name": "it-healer/laravel-bitcoin",
    "description": "A library for Laravel that allows you to create and manage the Bitcoin cryptocurrency.",
    "homepage": "https://github.com/it-healer/laravel-bitcoin",
    "license": "MIT",
    "authors": [
        {
            "name": "IT-HEALER",
            "email": "info@it-healer.com"
        }
    ],
    "keywords": [
        "it-healer",
        "laravel",
        "bitcoin",
        "btc",
        "php"
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "guzzlehttp/guzzle": "^7.2",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.92.0",
        "brick/math": ">=0.12",
        "simplito/elliptic-php": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "ItHealer\\LaravelBitcoin\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ItHealer\\LaravelBitcoin\\BitcoinServiceProvider"
            ],
            "aliases": {
                "Bitcoin": "ItHealer\\LaravelBitcoin\\Facades\\Bitcoin"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ItHealer\\LaravelBitcoin\\Tests\\": "tests/"
        }
    }
}
